# Aumentar Faturamento

# Obj: Como aumentar o faturamento da empresa, dado os dados do mês anterios.

# Entrada v1: Os dados de pedido e performance do mês anterior.
# Entrada v2: O mês
# Saída: A Lista das 3 melhores ações possíveis a serem implementadas.

# Obter os dados da empresa

# Como obter dados da empresa, dado o mês a ser analisado.
# Entrada: Um mês.
# Saída: Uma lista com dados de pedido e performance.


fun aumentar-faturamento-v2(mes) -> Lista[Acoes]
    acoes = extrai-acoes(obter-dados(mes))
    return acoes

fun obter-dados(mes) -> Lista[dados]




fun aumentar-faturamento-v1(dados-mes-anterior) -> Lista[Acoes]

fun obter-dados(mes) -> Lista[dados]

fun aumenta-faturamento-empresa(mes) -> Lista[Acoes]
     dados = obter-dados(mes)
     lista-acoes = aumentar-faturamento-v1(dados)
     return lista-acoes